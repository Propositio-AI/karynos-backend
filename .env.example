# ── アプリ ──────────────────────────────────────────
APP_NAME=Karynos-Backend
CORS_ORIGINS=http://localhost:3000

# ── データベース (PostgreSQL コンテナ設定用) ──────────
POSTGRES_USER=karynos
POSTGRES_PASSWORD=karynos
POSTGRES_DB=karynos

# ── データベース (アプリ接続設定) ─────────────────────
DB_USER=karynos
DB_PASS=karynos
DB_HOST=karynos-db
DB_PORT=5432
DB_NAME=karynos
DATABASE_URL=postgresql://karynos:karynos@karynos-db:5432/karynos

# ── Qdrant ───────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_JOB_COLLECTION=job_vector_db

# ── CSV インポート ────────────────────────────────────
CSV_IMPORT_CONFIG_JSON=/app/db/import/table_sources.json
CSV_IMPORT_SKIP_IF_TABLE_HAS_DATA=true

# ── OpenAI ───────────────────────────────────────────
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-your-api-key-here

# ── 認証 (Amazon Cognito) ─────────────────────────────
# USE_MOCK_AUTH=true の間は JWT 検証をスキップしてモックユーザーで動作する。
# 本番環境では USE_MOCK_AUTH=false にして以下の値を設定すること。
USE_MOCK_AUTH=true
# COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=ap-northeast-1
