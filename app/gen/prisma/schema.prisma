generator client {
  provider      = "prisma-client-py"
  output        = "."
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShareType {
  PRIVATE
  PUBLIC

  @@map("share_type")
}

enum RoleType {
  user
  assistant
  system

  @@map("role_type")
}

enum MaterialStatus {
  DRAFT
  REVIEWING
  DISTRIBUTED

  @@map("material_status")
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("generation_job_status")
}

model Industry {
  industry_id Int     @id @default(autoincrement())
  name        String
  description String?
  jobs        Job[]

  @@map("industries")
}

model JobCategory {
  category_id Int     @id @default(autoincrement())
  name        String
  description String?
  jobs        Job[]

  @@map("job_categories")
}

model Skill {
  skill_id        Int             @id @default(autoincrement())
  name            String
  feedback_skills FeedbackSkill[]

  @@map("skills")
}

model Certification {
  certification_id        Int                     @id @default(autoincrement())
  name                    String
  feedback_certifications FeedbackCertification[]

  @@map("certifications")
}

model Company {
  company_id         Int               @id @default(autoincrement())
  name               String
  feedback_companies FeedbackCompany[]

  @@map("companies")
}

model Talent {
  talent_id        Int              @id @default(autoincrement())
  name             String
  feedback_talents FeedbackTalent[]

  @@map("talents")
}

model Interest {
  interest_id        Int                @id @default(autoincrement())
  name               String
  feedback_interests FeedbackInterest[]

  @@map("interests")
}

model Job {
  job_id        Int           @id @default(autoincrement())
  industry_id   Int
  category_id   Int?
  name          String
  description   String?
  updated_at    DateTime      @default(now())
  created_at    DateTime      @default(now())
  industry             Industry           @relation(fields: [industry_id], references: [industry_id], onDelete: Restrict)
  category             JobCategory?       @relation(fields: [category_id], references: [category_id], onDelete: Restrict)
  job_images           JobImage[]
  job_feedbacks        JobFeedback[]
  histories            History[]
  generated_materials  GeneratedMaterial[]

  @@map("jobs")
}

model JobImage {
  img_id     Int      @id @default(autoincrement())
  job_id     Int
  img_url    String
  alt        String
  created_at DateTime @default(now())
  job        Job      @relation(fields: [job_id], references: [job_id], onDelete: Restrict)

  @@map("job_images")
}

model JobFeedback {
  feedback_id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id                 Int
  salary                 Int?
  level                  Int?
  end_time               DateTime?               @db.Time(6)
  holiday                Int?
  overtime_hours         Int?
  age                    Int?
  tenure_years           Int?
  marriage_age           Int?
  gender_ratio           Float?
  romance_rate           Float?
  social_signification   String?
  personality_traits     String?
  growth_opportunities   String?
  wrong_image            String?
  uniform                Boolean?
  work_life_balance      Float?
  future_outlook         String?
  rarity                 Float?
  scandal_history        String?
  focus_on_education     Boolean?
  focus_on_achievements  Boolean?
  appeal_points          String?
  daily_routine          String?
  comments               String?
  updated_at             DateTime                @default(now())
  created_at             DateTime                @default(now())
  job                    Job                     @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  feedback_skill         FeedbackSkill[]
  feedback_certification FeedbackCertification[]
  feedback_company       FeedbackCompany[]
  feedback_talent        FeedbackTalent[]
  feedback_interest      FeedbackInterest[]

  @@map("job_feedbacks")
}

model FeedbackSkill {
  feedback_id String      @db.Uuid
  skill_id    Int
  is_required Boolean     @default(false)
  created_at  DateTime    @default(now())
  feedback    JobFeedback @relation(fields: [feedback_id], references: [feedback_id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skill_id], references: [skill_id], onDelete: Restrict)

  @@id([feedback_id, skill_id])
  @@map("feedback_skill")
}

model FeedbackCertification {
  feedback_id      String        @db.Uuid
  certification_id Int
  is_required      Boolean       @default(false)
  created_at       DateTime      @default(now())
  feedback         JobFeedback   @relation(fields: [feedback_id], references: [feedback_id], onDelete: Cascade)
  certification    Certification @relation(fields: [certification_id], references: [certification_id], onDelete: Restrict)

  @@id([feedback_id, certification_id])
  @@map("feedback_certification")
}

model FeedbackCompany {
  feedback_id String      @db.Uuid
  company_id  Int
  created_at  DateTime    @default(now())
  feedback    JobFeedback @relation(fields: [feedback_id], references: [feedback_id], onDelete: Cascade)
  company     Company     @relation(fields: [company_id], references: [company_id], onDelete: Restrict)

  @@id([feedback_id, company_id])
  @@map("feedback_company")
}

model FeedbackTalent {
  feedback_id String      @db.Uuid
  talent_id   Int
  is_required Boolean     @default(false)
  created_at  DateTime    @default(now())
  feedback    JobFeedback @relation(fields: [feedback_id], references: [feedback_id], onDelete: Cascade)
  talent      Talent      @relation(fields: [talent_id], references: [talent_id], onDelete: Restrict)

  @@id([feedback_id, talent_id])
  @@map("feedback_talent")
}

model FeedbackInterest {
  feedback_id String      @db.Uuid
  interest_id Int
  is_required Boolean     @default(false)
  created_at  DateTime    @default(now())
  feedback    JobFeedback @relation(fields: [feedback_id], references: [feedback_id], onDelete: Cascade)
  interest    Interest    @relation(fields: [interest_id], references: [interest_id], onDelete: Restrict)

  @@id([feedback_id, interest_id])
  @@map("feedback_interest")
}

model History {
  history_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id     Int
  dreamer_id String   @db.Uuid
  good       Boolean  @default(false)
  bad        Boolean  @default(false)
  save       Boolean  @default(false)
  created_at DateTime @default(now())
  job        Job      @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@map("histories")
}

model Dreamer {
  dreamer_id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       Int?
  cognito_sub           String?              @unique
  login_id              String
  name_family           String
  name_given            String
  last_login_at         DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @default(now())
  dreamer_group_members DreamerGroupMember[]
  user_initial_answers  UserInitialAnswer[]
  enrollments           Enrollment[]
  generated_materials   GeneratedMaterial[]

  @@map("dreamers")
}

model DreamerGroup {
  group_id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  description           String?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @default(now())
  dreamer_group_members DreamerGroupMember[]

  @@map("dreamer_groups")
}

model DreamerGroupMember {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String       @db.Uuid
  dreamer_id String       @db.Uuid
  joined_at  DateTime     @default(now())
  created_at DateTime     @default(now())
  group      DreamerGroup @relation(fields: [group_id], references: [group_id], onDelete: Restrict)
  dreamer    Dreamer      @relation(fields: [dreamer_id], references: [dreamer_id], onDelete: Restrict)

  @@map("dreamer_group_members")
}

model InitQuestion {
  question_id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version               Int                  @default(1)
  category              String
  question_text         String
  question_order        Int
  is_active             Boolean              @default(true)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @default(now())
  init_question_options InitQuestionOption[]
  user_initial_answers  UserInitialAnswer[]

  @@map("init_questions")
}

model InitQuestionOption {
  option_id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id          String              @db.Uuid
  option_order         Int
  option_text          String
  created_at           DateTime            @default(now())
  question             InitQuestion        @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  user_initial_answers UserInitialAnswer[]

  @@map("init_question_options")
}

model UserInitialAnswer {
  answer_id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dreamer_id       String             @db.Uuid
  question_id      String             @db.Uuid
  option_id        String             @db.Uuid
  question_version Int
  answered_at      DateTime           @default(now())
  created_at       DateTime           @default(now())
  updated_at       DateTime           @default(now())
  dreamer          Dreamer            @relation(fields: [dreamer_id], references: [dreamer_id], onDelete: Cascade)
  question         InitQuestion       @relation(fields: [question_id], references: [question_id], onDelete: Restrict)
  option           InitQuestionOption @relation(fields: [option_id], references: [option_id], onDelete: Restrict)

  @@map("user_initial_answers")
}

model Conversation {
  conversation_id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                  String                    @db.Uuid
  job_id                    String
  job_name                  String
  assistant_name            String?
  assistant_gender          String?
  last_message_at           DateTime                  @default(now())
  share_type                ShareType                 @default(PRIVATE)
  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @default(now())
  messages                  Message[]
  conversation_participants ConversationParticipant[]

  @@map("conversations")
}

model Message {
  message_id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  sender_id       String       @db.Uuid
  role            RoleType
  text_content    String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Restrict)

  @@map("messages")
}

model ConversationParticipant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  user_id         String       @db.Uuid
  joined_at       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Restrict)

  @@map("conversation_participants")
}

model Mentor {
  mentor_id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognito_sub   String           @unique
  login_id      String
  name_family   String
  name_given    String
  email         String
  last_login_at DateTime?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @default(now())
  school_classes   SchoolClass[]
  lesson_materials LessonMaterial[]

  @@map("mentors")
}

model SchoolClass {
  class_id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentor_id        String           @db.Uuid
  name             String
  subject          String?
  description      String?
  academic_year    Int?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now())
  mentor           Mentor           @relation(fields: [mentor_id], references: [mentor_id], onDelete: Cascade)
  enrollments      Enrollment[]
  lesson_materials LessonMaterial[]
  generation_jobs  GenerationJob[]

  @@map("classes")
}

model Enrollment {
  enrollment_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id      String      @db.Uuid
  dreamer_id    String      @db.Uuid
  enrolled_at   DateTime    @default(now())
  created_at    DateTime    @default(now())
  school_class  SchoolClass @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  dreamer       Dreamer     @relation(fields: [dreamer_id], references: [dreamer_id], onDelete: Cascade)

  @@unique([class_id, dreamer_id])
  @@map("enrollments")
}

model LessonMaterial {
  material_id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id             String              @db.Uuid
  mentor_id            String              @db.Uuid
  title                String
  subject              String?
  unit                 String?
  description          String?
  file_name            String
  file_path            String
  file_size            Int
  mime_type            String
  content_text         String?
  content_hash         String?
  is_deleted           Boolean             @default(false)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @default(now())
  school_class         SchoolClass         @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  mentor               Mentor              @relation(fields: [mentor_id], references: [mentor_id], onDelete: Restrict)
  generated_materials  GeneratedMaterial[]
  generation_jobs      GenerationJob[]

  @@map("lesson_materials")
}

model GeneratedMaterial {
  generated_material_id String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_material_id    String         @db.Uuid
  dreamer_id            String         @db.Uuid
  job_id                Int?
  job_name              String
  title                 String?
  content               String?
  status                MaterialStatus @default(DRAFT)
  idempotency_key       String         @unique
  is_read               Boolean        @default(false)
  distributed_at        DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @default(now())
  lesson_material       LessonMaterial @relation(fields: [lesson_material_id], references: [material_id], onDelete: Restrict)
  dreamer               Dreamer        @relation(fields: [dreamer_id], references: [dreamer_id], onDelete: Cascade)
  job                   Job?           @relation(fields: [job_id], references: [job_id], onDelete: SetNull)

  @@map("generated_materials")
}

model GenerationJob {
  generation_job_id  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_material_id String              @db.Uuid
  class_id           String              @db.Uuid
  status             GenerationJobStatus @default(PENDING)
  progress           Int                 @default(0)
  total_dreamers     Int                 @default(0)
  completed_dreamers Int                 @default(0)
  error_message      String?
  started_at         DateTime?
  completed_at       DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now())
  lesson_material    LessonMaterial      @relation(fields: [lesson_material_id], references: [material_id], onDelete: Cascade)
  school_class       SchoolClass         @relation(fields: [class_id], references: [class_id], onDelete: Cascade)

  @@map("generation_jobs")
}
